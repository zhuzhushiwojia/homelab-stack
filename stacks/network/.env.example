# Network Stack — Environment Variables
# Copy this file to .env and fill in your values

# Required
DOMAIN=home.example.com           # Your domain for service URLs
TZ=Asia/Shanghai                   # Your timezone

# Optional
CN_MODE=false                      # Set to true to use Chinese Docker mirrors

# WireGuard Configuration
WG_SERVER_URL=auto                 # auto = auto-detect, or set to your public IP/domain
WG_SERVER_PORT=51820               # WireGuard server port (UDP)
WG_INTERNAL_SUBNET=10.13.13.0      # Internal VPN subnet
