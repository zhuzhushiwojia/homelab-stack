# Domain Configuration
DOMAIN=your-domain.com

# Database Configuration
POSTGRES_PASSWORD=strong_postgres_password_here
GITEA_DB_PASSWORD=strong_gitea_db_password_here
VAULTWARDEN_DB_PASSWORD=strong_vaultwarden_db_password_here
OUTLINE_DB_PASSWORD=strong_outline_db_password_here
REDIS_PASSWORD=strong_redis_password_here

# Gitea Configuration
GITEA_JWT_SECRET=generate_with_openssl_rand_hex_32

# Vaultwarden Configuration
VAULTWARDEN_ADMIN_TOKEN=generate_with_openssl_rand_hex_32

# Outline Configuration
OUTLINE_SECRET_KEY=generate_with_openssl_rand_hex_32
OUTLINE_UTILS_SECRET=generate_with_openssl_rand_hex_32
OUTLINE_OIDC_CLIENT_ID=outline_client_id_from_authentik
OUTLINE_OIDC_CLIENT_SECRET=outline_client_secret_from_authentik

# MinIO Configuration (for Outline file storage)
MINIO_ACCESS_KEY=minio_access_key
MINIO_SECRET_KEY=minio_secret_key
MINIO_ENDPOINT=http://minio:9000

# SMTP Configuration (for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=your-email@gmail.com

# Traefik Configuration
TRAEFIK_TAG=traefik
TRAEFIK_PUBLIC_NETWORK=traefik-public
TRAEFIK_DOMAIN=${DOMAIN}

# Security Notes:
# 1. Generate random passwords using: openssl rand -hex 32
# 2. Never commit this file with real passwords
# 3. Copy to .env and fill in actual values
# 4. Keep .env file secure and backed up