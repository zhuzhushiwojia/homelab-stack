# Homelab Integration Testing Framework - Environment Configuration
# Copy this file to .env and customize for your deployment
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose --env-file .env up -d

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL database user
DB_USER=homelab

# PostgreSQL database password (CHANGE THIS!)
DB_PASSWORD=changeme

# PostgreSQL database name
DB_NAME=homelab

# =============================================================================
# Grafana Configuration
# =============================================================================

# Grafana admin username
GRAFANA_USER=admin

# Grafana admin password (CHANGE THIS!)
GRAFANA_PASSWORD=admin

# =============================================================================
# General Settings
# =============================================================================

# Timezone for containers
TZ=Asia/Shanghai

# Log level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# Network Configuration
# =============================================================================

# External hostname for services
HOSTNAME=localhost

# HTTP port for web services
HTTP_PORT=80

# HTTPS port for web services
HTTPS_PORT=443

# =============================================================================
# Monitoring Configuration
# =============================================================================

# Prometheus scrape interval
PROMETHEUS_SCRAPE_INTERVAL=15s

# Prometheus data retention
PROMETHEUS_RETENTION=15d

# =============================================================================
# Security Settings
# =============================================================================

# Enable/disable HTTPS redirect
HTTPS_REDIRECT=false

# Session timeout (seconds)
SESSION_TIMEOUT=3600

# =============================================================================
# Resource Limits (optional)
# =============================================================================

# Memory limit for services (e.g., 512M, 1G)
# MEMORY_LIMIT=512M

# CPU limit for services (e.g., 0.5, 1.0)
# CPU_LIMIT=0.5

# =============================================================================
# Backup Configuration (optional)
# =============================================================================

# Backup directory
# BACKUP_DIR=/path/to/backups

# Backup schedule (cron format)
# BACKUP_SCHEDULE=0 2 * * *

# =============================================================================
# Optional Services
# =============================================================================

# Enable/disable optional services (true/false)
ENABLE_TRAEFIK=false
ENABLE_LOKI=false

# =============================================================================
# Testing Configuration
# =============================================================================

# Test timeout (seconds)
TEST_TIMEOUT=30

# Skip Docker tests (true/false)
SKIP_DOCKER_TESTS=false

# Skip HTTP tests (true/false)
SKIP_HTTP_TESTS=false

# Verbose test output (true/false)
TEST_VERBOSE=false
